# Gemini / Google ADK configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=atgeir-moae-dev
GOOGLE_CLOUD_LOCATION=us-central1

# Optional local-only input. Leave commented to collect live BigQuery data.
# MARKETING_DATA_PATH=marketing_growth_agent/tests/fixtures/marketing_data.json

# Required when MARKETING_DATA_PATH is not set and BigQuery is used.
MARKETING_PIPELINE_TARGET=1500000
MARKETING_DEFAULT_TARGET_CPL=150
MARKETING_LOOKBACK_DAYS=365

# Salesforce Lead and Opportunity data is read from this MCP server.
SALESFORCE_MCP_URL=https://salesforce-mcp-server-v3-621913909275.us-central1.run.app/sse
SALESFORCE_MCP_RECORD_LIMIT=5000
SALESFORCE_MCP_TRANSPORT=auto
SALESFORCE_MCP_AUTH=auto
SALESFORCE_MCP_ARGUMENT_MODE=auto
# Use only when the MCP dataset guarantees Lead/Opportunity positional alignment.
SALESFORCE_POSITIONAL_JOIN_FALLBACK=true
MARKETING_SALESFORCE_ENABLED=true

# BigQuery location for ad-platform tables.
MARKETING_GCP_PROJECT_ID=atgeir-moae-dev
MARKETING_BIGQUERY_DATASET=marketing_agent

# Print each intermediate agent response before the combined report.
MARKETING_VERBOSE_AGENT_OUTPUT=true

# Gmail notifications. Addresses must be explicitly configured.
MARKETING_EMAIL_NOTIFICATIONS_ENABLED=true
MARKETING_MANAGER_EMAIL=manager@example.com
MARKETING_REPORT_EMAIL=rep@example.com
GMAIL_OAUTH_CLIENT_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json
